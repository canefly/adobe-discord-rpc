      <Host Name="AEFT" />
    </HostList>
    <DispatchInfo>
      <Resources>
        <MainPath>./rpc.html</MainPath>
        <ScriptPath>./host/AEFT.jsx</ScriptPath>
        <CEFCommandLine>
