    <Extension Id="com.tee.discord-rpc-panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <CEFCommandLine>
              <Parameter>--enable-nodejs</Parameter>
              <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Discord Rich Presence</Menu>
          <Geometry>
            <Size>
              <Width>350</Width>
              <Height>500</Height>
            </Size>
            <!-- <MinSize>
              <Width>350</Width>
              <Height>500</Height>
            </MinSize> -->
            <MaxSize>
              <Width>350</Width>
              <Height>500</Height>
            </MaxSize>
          </Geometry>
          <Icons>
              <Icon Type="Normal">./icons/favicon.ico</Icon>
              <Icon Type="RollOver">./icons/favicon.ico</Icon>
              <Icon Type="DarkNormal">./icons/favicon.ico</Icon>
              <Icon Type="DarkRollOver">./icons/favicon.ico</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>

  

  <Extension Id="com.tee.discord-rpc.after-effects">
